{
  "ci": {
    "collect": {
      "url": ["http://localhost:3100/album-wall/"],
      "startServerCommand": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/serve-static.ts",
      "startServerReadyPattern": "Serving out/",
      "numberOfRuns": 3
    },
    "assert": {
      "aggregationMethod": "median",
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.7
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
