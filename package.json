{
  "name": "vinyl-wall",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:static": "npm run check:env && cross-env NEXT_STATIC_EXPORT=true next build",
    "check:env": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/check-deploy-env.ts",
    "check:static-output": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/check-static-output.ts",
    "build:ssr": "cross-env NEXT_STATIC_EXPORT=false next build",
    "start": "serve out -s -p 3001",
    "start:next": "next start --port 3001",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix && prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "export": "next build",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx}\"",
    "type-check": "next typegen && tsc --noEmit",
    "fix-all": "npm run lint:fix && npm run type-check",
    "precommit-check": "npm run lint && npm run type-check",
    "prepare": "lefthook install",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "test:a11y": "playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "disconnect": "^1.2.2",
    "html2canvas-pro": "^2.5.1",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^3.2.7",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "jsdom": "^26.1.0",
    "lefthook": "^2.1.16",
    "postcss": "^8",
    "prettier": "^3.9.9",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  }
}
